# Generate local values with: node scripts/init-env.mjs
# Never commit .env. Required secrets have no shared default.
AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
TRAJET_DB_PASSWORD=
GEO_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
TICKET_DB_PASSWORD=
ABONNEMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
RABBITMQ_USER=wasalny
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
INTERNAL_API_KEY=
# Base64-encoded random bytes, shared by every JWT consumer.
JWT_EXPIRATION=86400000

# Local SMTP inbox: http://localhost:8025. For real SMTP, adapt these settings.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
SUPPORT_EMAIL=noreply@wasalny.local

JWT_SECRET=
